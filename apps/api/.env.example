# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
# Used to build links in emails (verification, password reset, invitations)
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/exportpro?schema=public"

# AI provider — Sprint 5 product classification.
# AI_PROVIDER: anthropic | development | none. Leave unset to auto-select
# (anthropic when a key is set; deterministic development provider otherwise,
# never in production). Development results are labeled DEMO in the UI.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=30000
AI_ENABLED=true

# Email provider — future sprint
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# WhatsApp provider — future sprint
WHATSAPP_PROVIDER_API_KEY=

# External trade-data sources — future sprint
TRADE_DATA_API_KEY=

# Object storage — future sprint
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment provider — future sprint
PAYMENT_PROVIDER_API_KEY=

# Analytics — future sprint
ANALYTICS_WRITE_KEY=
