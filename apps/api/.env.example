# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/exportpro?schema=public"

# Auth foundation — real values arrive with Sprint 2
JWT_SECRET=
JWT_EXPIRES_IN=15m

# AI provider — future sprint
AI_PROVIDER_API_KEY=

# Email provider — future sprint
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# WhatsApp provider — future sprint
WHATSAPP_PROVIDER_API_KEY=

# External trade-data sources — future sprint
TRADE_DATA_API_KEY=

# Object storage — future sprint
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment provider — future sprint
PAYMENT_PROVIDER_API_KEY=

# Analytics — future sprint
ANALYTICS_WRITE_KEY=
