  requestId          String?
  request            FreightRequest?      @relation(fields: [requestId], references: [id], onDelete: SetNull)
  purchaseOrderId    String?
  quotationId        String?
  providerId         String?
  provider           LogisticsProvider?   @relation(fields: [providerId], references: [id], onDelete: SetNull)
  forwarderName      String
  shippingLine       String?
  carrier            String?
  serviceName        String?
  quoteReference     String?
  transportMode      String
  shipmentType       String?
  containerSummary   String?
  origin             String?
  destination        String?
  portOfLoading      String?
  portOfDischarge    String?
  routeSummary       String?
  transshipmentPorts String[]             @default([])
  currency           String
  totalCost          Decimal?             @db.Decimal(20, 2)
  transitDays        Int?
  freeDays           Int?
  validityFrom       DateTime?            @db.Timestamptz(3)
  validityUntil      DateTime?            @db.Timestamptz(3)
  departureDate      DateTime?            @db.Timestamptz(3)
  arrivalDate        DateTime?            @db.Timestamptz(3)
  inclusions         String?
  exclusions         String?
  terms              String?
  riskNotes          String?
