}

model ProfitabilityAdjustment {
  id              String   @id @default(cuid())
  organizationId  String
  shipmentId      String
  type            String
  amount          Decimal  @db.Decimal(20, 2)
  currency        String
  reason          String
  createdByUserId String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, shipmentId])
  @@map("profitability_adjustments")
}

model ShipmentProfitability {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipmentId        String       @unique
  finalized         Boolean      @default(false)
  finalizedAt       DateTime?    @db.Timestamptz(3)
  finalizedByUserId String?
  currentSnapshotId String?
  confirmedNone     String[]     @default([])
  reopenedAt        DateTime?    @db.Timestamptz(3)
  reopenedByUserId  String?
  reopenReason      String?
  rowVersion        Int          @default(0)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  snapshots ProfitabilitySnapshot[]

  @@index([organizationId, finalized])
  @@map("shipment_profitability")
}

/// Immutable finalized profitability; reopening marks it superseded but keeps it.
model ProfitabilitySnapshot {
  id                String                @id @default(cuid())
  organizationId    String
  profitabilityId   String
  profitability     ShipmentProfitability @relation(fields: [profitabilityId], references: [id], onDelete: Cascade)
  shipmentId        String
  version           Int
  data              Json
  finalizedByUserId String
  finalizedAt       DateTime              @default(now()) @db.Timestamptz(3)
  supersededAt      DateTime?             @db.Timestamptz(3)
  reopenReason      String?

  @@unique([profitabilityId, version])
  @@map("profitability_snapshots")
}

model ReorderReminder {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
