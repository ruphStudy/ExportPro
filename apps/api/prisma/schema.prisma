  productId       String?
  productName     String?
  windowStart     DateTime     @db.Timestamptz(3)
  windowEnd       DateTime     @db.Timestamptz(3)
  status          String       @default("SUGGESTED")
  snoozedUntil    DateTime?    @db.Timestamptz(3)
  message         String
  basis           Json
  dismissReason   String?
  rowVersion      Int          @default(0)
  createdByUserId String
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, buyerCompanyId, windowStart])
  @@map("reorder_reminders")
}
