  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, status])
  @@map("freight_quotes")
}

model FreightQuoteCharge {
  id        String       @id @default(cuid())
  quoteId   String
  quote     FreightQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  category  String
  label     String?
  amount    Decimal      @db.Decimal(20, 2)
  sortOrder Int          @default(0)

  @@index([quoteId])
  @@map("freight_quote_charges")
}

/// Private files for freight quotes, shipments, exceptions and claims.
model LogisticsAttachment {
  id               String   @id @default(cuid())
  organizationId   String
  entityType       String
  entityId         String
  shipmentId       String?
  exceptionId      String?
  claimId          String?
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  checksum         String
  uploadedByUserId String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, entityType, entityId])
  @@map("logistics_attachments")
}

model Shipment {
  id                       String                  @id @default(cuid())
  organizationId           String
  organization             Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipmentNumber           String
  purchaseOrderId          String
  freightQuoteId           String?
  freightQuote             FreightQuote?           @relation(fields: [freightQuoteId], references: [id], onDelete: SetNull)
  proformaInvoiceId        String?
  quotationId              String?
  crmLeadId                String?
  buyerCompanyId           String
  mode                     String
  shipmentType             String?
  incoterm                 String?
  incotermPlace            String?
  originCountry            String?
  destinationCountry       String?
  portOfLoading            String?
  portOfDischarge          String?
  placeOfReceipt           String?
  placeOfDelivery          String?
  carrier                  String?
  shippingLine             String?
  vesselName               String?
  voyageNumber             String?
  flightNumber             String?
  vehicleReference         String?
  bookingReference         String?
  blNumber                 String?
  awbNumber                String?
  originalEtd              DateTime?               @db.Timestamptz(3)
  etd                      DateTime?               @db.Timestamptz(3)
  etdUpdatedAt             DateTime?               @db.Timestamptz(3)
  originalEta              DateTime?               @db.Timestamptz(3)
  eta                      DateTime?               @db.Timestamptz(3)
  etaUpdatedAt             DateTime?               @db.Timestamptz(3)
  actualDeparture          DateTime?               @db.Timestamptz(3)
  actualArrival            DateTime?               @db.Timestamptz(3)
  deliveredAt              DateTime?               @db.Timestamptz(3)
  status                   String                  @default("PLANNED")
  holdFromStatus           String?
  health                   String                  @default("ON_TRACK")
  /// Cargo snapshot with per-field origin (packing list, PO, manual …).
  cargo                    Json
  shippingBillNumber       String?
  shippingBillDate         DateTime?               @db.Timestamptz(3)
  customsBroker            String?
  customsClearedAt         DateTime?               @db.Timestamptz(3)
  complianceAcknowledged   Boolean                 @default(false)
  complianceOverrideReason String?
  quotedCost               Decimal?                @db.Decimal(20, 2)
  quotedCurrency           String?
  actualFreight            Decimal?                @db.Decimal(20, 2)
  actualSurcharges         Decimal?                @db.Decimal(20, 2)
  actualLocalCharges       Decimal?                @db.Decimal(20, 2)
  actualCostCurrency       String?
  actualCostNotes          String?
  trackingProvider         String?
  trackingLastFetchedAt    DateTime?               @db.Timestamptz(3)
  trackingLastError        String?
  ownerUserId              String?
  notes                    String?
  rowVersion               Int                     @default(0)
  createdByUserId          String
  createdAt                DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @db.Timestamptz(3)
  milestones               ShipmentMilestone[]
  legs                     ShipmentLeg[]
  containers               ShipmentContainer[]
  trackingEvents           ShipmentTrackingEvent[]
  exceptions               ShipmentException[]
  claims                   ShipmentClaim[]
  buyerUpdates             ShipmentBuyerUpdate[]

  @@unique([organizationId, shipmentNumber])
  @@index([organizationId, status])
  @@index([organizationId, purchaseOrderId])
  @@map("shipments")
}

model ShipmentMilestone {
  id                String    @id @default(cuid())
  shipmentId        String
  shipment          Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  stage             String
  sortOrder         Int
  status            String    @default("NOT_STARTED")
  plannedAt         DateTime? @db.Timestamptz(3)
  estimatedAt       DateTime? @db.Timestamptz(3)
  actualAt          DateTime? @db.Timestamptz(3)
  location          String?
  source            String    @default("MANUAL")
  notes             String?
  reason            String?
  completedByUserId String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([shipmentId, stage])
  @@map("shipment_milestones")
}

model ShipmentLeg {
  id               String    @id @default(cuid())
  shipmentId       String
  shipment         Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sequence         Int
