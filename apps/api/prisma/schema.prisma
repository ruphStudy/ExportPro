// Prisma schema — Sprint 1 (tenancy/audit foundation) + Sprint 2
// (authentication, sessions, organization identity, invitations) +
// Sprint 3 (exporter onboarding, preferences, registrations,
// certifications, documents, readiness scoring).
// Sprint 4 (opportunity discovery, scoring, watchlist, saved searches).
// Sprint 5 (product analysis, HS/ITC-HS classification, saved products).
// Business-domain models (buyers, CRM, costing, etc.) are intentionally
// NOT created yet — see ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Role a user holds within a single organization (tenant).
/// Deliberately a flat enum — see ARCHITECTURE.md "Roles & Permissions"
/// for why this is static rather than a Role/Permission table.
enum MembershipRole {
  OWNER
  ADMIN
  EXPORT_MANAGER
  SALES
  DOCUMENTATION
  LOGISTICS
  FINANCE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

/// Direction of trade a tenant (or a record within a tenant) operates in.
/// The product supports both from day one even though EXPORT ships first.
enum TradeDirection {
  EXPORT
  IMPORT
}

enum BusinessType {
  MANUFACTURER
  MERCHANT_EXPORTER
  TRADER
  IMPORTER
  EXPORTER_IMPORTER
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
}

// --- Sprint 3: exporter onboarding -----------------------------------

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ExportExperience {
  NONE
  LESS_THAN_1_YEAR
  ONE_TO_THREE_YEARS
  THREE_TO_FIVE_YEARS
  FIVE_TO_TEN_YEARS
  TEN_PLUS_YEARS
}

enum RiskTolerance {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE
}

enum InvestmentRange {
  UNDER_1L
  L1_5
  L5_10
  L10_25
  L25_50
  L50_1CR
  ABOVE_1CR
}

enum ShipmentPreference {
  SAMPLES_ONLY
  COURIER_PARCEL
  UNDER_100KG
  KG_100_500
  KG_500_1MT
  MT_1_5
  MT_5_20
  CONTAINER_SCALE
  FLEXIBLE
}

enum LogisticsMode {
  SEA
  AIR
  COURIER
  ROAD
  FLEXIBLE
}

enum ExportGoal {
  FIND_FIRST_PRODUCT
  START_EXPORTING_EXISTING
  FIND_BUYERS
  EXPAND_COUNTRIES
  INCREASE_REVENUE
  IMPROVE_PROFITABILITY
  REDUCE_RISK
  AUTOMATE_OPERATIONS
  BUILD_REPEAT_BUSINESS
}

enum ProductInterestType {
  CURRENT
  INTERESTED
}

enum CountryRelation {
  CURRENT
  INTERESTED
}

/// IEC/GST/FSSAI/APEDA share one model — see ARCHITECTURE.md
/// "Registrations" — rather than four near-identical tables.
enum RegistrationType {
  IEC
  GST
  FSSAI
  APEDA
}

/// Deliberately unified across all four registration types even though
/// their real-world wording differs slightly (e.g. GST's "not
/// applicable" vs FSSAI's "required but not available") — the UI maps
/// type-specific copy onto these five states.
enum RegistrationStatus {
  NOT_APPLICABLE
  NOT_APPLIED
  APPLIED_PENDING
  AVAILABLE
  NOT_SURE
}

/// Deliberately conservative — see ARCHITECTURE.md "No Fake Government
/// Verification". VERIFIED must never be set just because a number was
/// typed in or a file was uploaded; nothing in Sprint 3 sets it.
enum VerificationStatus {
  NOT_PROVIDED
  USER_DECLARED
  FORMAT_VALID
  DOCUMENT_UPLOADED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum CertificationStatus {
  ACTIVE
  EXPIRED
  PENDING
}

enum OnboardingDocumentType {
  IEC
  GST
  FSSAI
  APEDA
  CERTIFICATE
}

// --- Sprint 4: opportunity discovery ----------------------------------

/// Sprint 4 only ever writes DEMO. Other values exist so Sprint 9's real
/// ingestion can populate this column without a schema change — see
/// ARCHITECTURE.md "Data Refresh Architecture".
enum OpportunitySourceType {
  DEMO
  OFFICIAL
  PUBLIC_DATA
  PARTNER
  INTERNAL
  AI_DERIVED
}

enum FreshnessStatus {
  FRESH
  RECENT
  STALE
  VERY_STALE
  UNKNOWN
}

/// Display-facing bucket. The stored `competitionScore` is always
/// "higher = more favorable" — see ARCHITECTURE.md "Opportunity Scoring".
enum CompetitionLevel {
  LOW
  MODERATE
  HIGH
}

enum ComplianceDifficulty {
  EASY
  MODERATE
  COMPLEX
}

enum SeasonalityLevel {
  LOW
  MODERATE
  HIGH
}

enum OpportunitySort {
  BEST
  GROWTH
  LOW_COMPETITION
  HIGH_MARGIN
  CONFIDENCE
  RECENT
}

/// A potential Product × Destination-Market pair. Global/read-only
/// reference data — not organization-scoped (see ARCHITECTURE.md
/// "Tenant Isolation"). All component scores are normalized 0–100
/// where higher always means better, including the three that are
/// naturally "bad when high" raw metrics (competition, compliance
/// difficulty, logistics complexity) — those are inverted before storage.
model Opportunity {
  id String @id @default(cuid())

  productName            String
  productCategoryCode    String
  destinationCountryCode String
  tradeDirection         TradeDirection @default(EXPORT)

  overallScore         Int
  demandScore          Int
  indiaExportScore     Int
  growthScore          Int
  competitionScore     Int
  complianceScore      Int
  logisticsScore       Int
  marginScore          Int
  seasonalityScore     Int
  marketDiversityScore Int
  confidenceScore      Int

  competitionLevel     CompetitionLevel
  complianceDifficulty ComplianceDifficulty
  seasonalityLevel     SeasonalityLevel
  /// Typical investment needed to pursue this opportunity — compared
  /// ordinally against the exporter's Sprint 3 investment range for the budget filter.
  investmentRange      InvestmentRange

  sourceType      OpportunitySourceType @default(DEMO)
  sourceName      String
  sourceUrl       String?
  sourceDate      DateTime
  freshnessStatus FreshnessStatus

  metadata Json? @default("{}")

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots       OpportunityScoreSnapshot[]
  savedBy         SavedOpportunity[]
  productAnalyses ProductAnalysis[]

  @@unique([productName, destinationCountryCode])
  @@index([destinationCountryCode])
  @@index([productCategoryCode])
  @@index([overallScore])
  @@map("opportunities")
}

/// Minimal score history — enough for a delta/trend display and future
/// alerts, not a general time-series platform (see ARCHITECTURE.md).
model OpportunityScoreSnapshot {
  id String @id @default(cuid())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  overallScore Int
  components   Json
  confidence   Int
  capturedAt   DateTime @default(now())

  @@index([opportunityId, capturedAt])
  @@map("opportunity_score_snapshots")
}

/// Organization-scoped watchlist entry. `alertEnabled`/`minimumScoreChange`/
/// `lastAlertedScore` are extension points for a future alert engine —
/// nothing in Sprint 4 sends notifications (see ARCHITECTURE.md "Future Alert Readiness").
model SavedOpportunity {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  savedByUserId String
  savedBy       User   @relation(fields: [savedByUserId], references: [id], onDelete: Cascade)

  notes              String?
  alertEnabled       Boolean @default(false)
  minimumScoreChange Int?
  lastAlertedScore   Int?

  createdAt DateTime @default(now())

  @@unique([organizationId, opportunityId])
  @@index([organizationId])
  @@map("saved_opportunities")
}

/// A named, reusable search/filter combination.
model SavedOpportunitySearch {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  /// { search?, category?, country?, budget?, minMarginScore?, minGrowthScore?, competitionLevel?, complianceDifficulty?, sort? }
  query Json

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("saved_opportunity_searches")
}

/// A person who can sign in. Identity is global; all tenant-scoped data
/// hangs off Membership, never directly off User, so one person can
/// belong to several organizations without data leaking between them.
model User {
  id              String    @id @default(cuid())
  /// Always stored lowercased/trimmed — see AuthService.normalizeEmail().
  /// No separate "normalizedEmail" column: the single column IS normalized.
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?

  memberships          Membership[]
  auditLogs            AuditLog[]
  sessions             Session[]
  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  sentInvitations      OrganizationInvitation[]
  savedOpportunities   SavedOpportunity[]
  createdSavedSearches SavedOpportunitySearch[]
  productAnalyses      ProductAnalysis[]
  confirmedProducts    OrganizationProduct[]    @relation("ProductConfirmedBy")
  ownedLeads           BuyerLead[]              @relation("LeadOwner")
  assignedLeadTasks    LeadTask[]               @relation("LeadTaskAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// One row per logged-in browser/device. The HttpOnly session cookie
/// carries an opaque token; only its SHA-256 hash is ever persisted —
/// see ARCHITECTURE.md "Authentication Architecture".
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  /// Server-resolved "current organization" for this device, persisted
  /// here (not trusted from the client) so it survives refresh and the
  /// organization switcher. Nullable until the user has a membership.
  activeOrganizationId String?

  userAgent  String?
  ipAddress  String?
  rememberMe Boolean @default(false)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@map("sessions")
}

/// Short-lived OTP for email verification. The code itself is never
/// stored — only its hash — and it is single-use (consumedAt) and
/// rate-limited by `attempts`.
model VerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  purpose  VerificationPurpose @default(EMAIL_VERIFICATION)
  attempts Int                 @default(0)

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// Single-use password reset token. The raw token is emailed to the
/// user and never stored — only its hash.
model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A tenant. Every piece of business data created in later sprints must
/// carry an organizationId that traces back here — this is the root of
/// the multi-tenancy strategy (see ARCHITECTURE.md "Tenant Isolation").
model Organization {
  id           String        @id @default(cuid())
  name         String
  legalName    String?
  slug         String        @unique
  businessType BusinessType?
  industry     String?
  website      String?
  email        String?
  phone        String?
  logoUrl      String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  timezone        String           @default("UTC")
  defaultCurrency String           @default("USD")
  tradeDirections TradeDirection[] @default([EXPORT])
  settings        Json?            @default("{}")
  isActive        Boolean          @default(true)

  memberships Membership[]
  auditLogs   AuditLog[]
  invitations OrganizationInvitation[]

  exporterProfile        ExporterProfile?
  productInterests       ProductInterest[]
  targetCountries        TargetCountry[]
  registrations          Registration[]
  certifications         Certification[]
  onboardingDocuments    OnboardingDocument[]
  savedOpportunities     SavedOpportunity[]
  savedSearches          SavedOpportunitySearch[]
  productAnalyses        ProductAnalysis[]
  products               OrganizationProduct[]
  privateBuyers          BuyerCompany[]
  buyerStates            OrganizationBuyer[]
  buyerLeads             BuyerLead[]
  leadTags               LeadTag[]
  outreachSettings       OrganizationOutreachSettings?
  outreachTemplates      OutreachTemplate[]
  outreachCampaigns      OutreachCampaign[]
  outreachSuppressions   OutreachSuppression[]
  exportCostings         ExportCosting[]
  fxRateSnapshots        FxRateSnapshot[]
  inquiries              BuyerInquiry[]
  commercialSettings     CommercialSettings?
  complianceRules        ComplianceRule[]
  complianceChecklists   ComplianceChecklist[]
  tradeDocuments         TradeDocument[]
  documentTemplates      DocumentTemplate[]
  documentExtractions    DocumentExtraction[]
  documentValidationRuns DocumentValidationRun[]
  logisticsProviders     LogisticsProvider[]
  freightRequests        FreightRequest[]
  freightQuotes          FreightQuote[]
  shipments              Shipment[]
  logisticsSettings      LogisticsSettings?
  quotations             Quotation[]
  proformaInvoices       ProformaInvoice[]
  purchaseOrders         BuyerPurchaseOrder[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  financeSettings       FinanceSettings?
  receivables           Receivable[]
  shipmentActualCosts   ShipmentActualCost[]
  shipmentProfitability ShipmentProfitability[]
  reorderReminders      ReorderReminder[]

  @@map("organizations")
}

/// Join model between User and Organization — this is the row every
/// tenant-aware query should pivot through (see TenantGuard / CurrentOrg).
model Membership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role   MembershipRole   @default(VIEWER)
  status MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// A pending invite to join an organization. Becomes a Membership only
/// once the invited person accepts — see ARCHITECTURE.md "Team
/// Management". The raw token is emailed; only its hash is stored.
model OrganizationInvitation {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email String
  role  MembershipRole

  invitedById String
  invitedBy   User   @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

/// Generic audit trail. One row per sensitive mutation, written by a
/// shared AuditService rather than ad hoc logging inside features —
/// see ARCHITECTURE.md "Audit Strategy".
model AuditLog {
  id String @id @default(cuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String
  metadata   Json?  @default("{}")

  createdAt DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

// --- Sprint 3: exporter onboarding -----------------------------------

/// One row per organization (enforced by the unique FK). Holds the
/// onboarding wizard's progress plus the business/commercial-preference
/// fields that don't warrant their own table. Lists of things (product
/// interests, countries, registrations, certifications) live in their
/// own models below — see ARCHITECTURE.md "Sprint 3 Data Model".
model ExporterProfile {
  id String @id @default(cuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Restricted at the DTO layer to MANUFACTURER / MERCHANT_EXPORTER /
  /// TRADER — reuses Organization's BusinessType enum rather than a
  /// second, conflicting taxonomy (see ARCHITECTURE.md "Exporter Type").
  exporterType     BusinessType?
  exportExperience ExportExperience?
  riskTolerance    RiskTolerance?

  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  currentStep      Int              @default(1)
  startedAt        DateTime?
  completedAt      DateTime?

  /// Codes into the shared PRODUCT_CATEGORIES / PREFERRED_INDUSTRIES
  /// config lists (@exportpro/types) — a stable, code-defined taxonomy
  /// rather than a database table, since the list itself rarely changes
  /// independently of a deploy. See ARCHITECTURE.md "Reference Data".
  productCategories   String[] @default([])
  preferredIndustries String[] @default([])

  investmentRange    InvestmentRange?
  desiredMarginMin   Int?
  desiredMarginMax   Int?
  shipmentPreference ShipmentPreference?
  preferredLogistics LogisticsMode[]     @default([])
  exportGoals        ExportGoal[]        @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exporter_profiles")
}

/// A product the org currently sells/manufactures or wants to explore.
/// Free-text + an optional category code — no HS classification here,
/// that is explicitly Sprint 4/5 (see ARCHITECTURE.md).
model ProductInterest {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  category     String?
  interestType ProductInterestType @default(INTERESTED)
  notes        String?

  /// Sprint 5: set once this interest has been analyzed and confirmed into
  /// a saved product. The interest itself is never overwritten or deleted.
  productId  String?
  product    OrganizationProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  analyzedAt DateTime?

  analyses ProductAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("product_interests")
}

/// A country the org exports to or is interested in. `countryCode` is
/// ISO 3166-1 alpha-2, validated against the shared COUNTRIES list
/// rather than stored as a free-text name.
model TargetCountry {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  countryCode String
  relation    CountryRelation @default(INTERESTED)

  createdAt DateTime @default(now())

  @@unique([organizationId, countryCode])
  @@index([organizationId])
  @@map("target_countries")
}

/// IEC / GST / FSSAI / APEDA — one row per type per org. See
/// ARCHITECTURE.md "No Fake Government Verification": `verificationStatus`
/// is never set to VERIFIED by anything in this sprint.
model Registration {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type               RegistrationType
  status             RegistrationStatus @default(NOT_SURE)
  number             String?
  verificationStatus VerificationStatus @default(NOT_PROVIDED)
  issueDate          DateTime?
  expiryDate         DateTime?
  metadata           Json?              @default("{}")

  documents OnboardingDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, type])
  @@index([organizationId])
  @@map("registrations")
}

/// Lightweight onboarding-level certificate record (ISO, HACCP, Organic,
/// APEDA-adjacent certificates, custom, ...). Deliberately not the full
/// Document Vault from a later sprint — see ARCHITECTURE.md.
model Certification {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Free-text code (e.g. "ISO", "HACCP", "CUSTOM") rather than a Prisma
  /// enum — the list is explicitly meant to be extensible without a migration.
  type   String
  name   String
  number String?
  issuer String?

  issueDate  DateTime?
  expiryDate DateTime?

  status             CertificationStatus @default(ACTIVE)
  verificationStatus VerificationStatus  @default(USER_DECLARED)
  notes              String?

  documents OnboardingDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("certifications")
}

/// Upload metadata only — the file itself lives in StorageService
/// (local disk in development; see Sprint 2). Kept separate from
/// Registration/Certification so a future Document Vault can adopt this
/// table (or migrate from it) without reshaping those two.
model OnboardingDocument {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  documentType OnboardingDocumentType

  registrationId  String?
  registration    Registration?  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  certificationId String?
  certification   Certification? @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  originalFilename String
  storageUrl       String
  mimeType         String
  sizeBytes        Int

  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([organizationId])
  @@index([registrationId])
  @@index([certificationId])
  @@map("onboarding_documents")
}

// --- Sprint 5: product analysis & classification -----------------------

enum ProductInputType {
  PRODUCT_NAME
  HS_CODE
  ITC_HS_CODE
  DESCRIPTION
}

enum CodeSystem {
  HS
  ITC_HS_INDIA
}

/// OFFICIALLY_VERIFIED is future-proofing only — nothing in Sprint 5 sets
/// it. USER_CONFIRMED = "use for platform analysis", not customs verification.
enum ProductClassificationStatus {
  AI_SUGGESTED
  USER_SELECTED
  USER_CONFIRMED
  OFFICIALLY_VERIFIED
}

enum ClassificationSource {
  AI_SUGGESTED
  REFERENCE_LOOKUP
  USER_SELECTED
}

enum AmbiguityStatus {
  CLEAR
  AMBIGUOUS
  INSUFFICIENT_INFORMATION
}

enum ProductAnalysisStatus {
  PENDING_REVIEW
  CONFIRMED
}

enum AnalysisSourceType {
  AI_DERIVED
  DEVELOPMENT_DEMO
  REFERENCE_LOOKUP
}

enum TariffReferenceSourceType {
  OFFICIAL
  DEVELOPMENT_SAMPLE
}

/// Global HS / ITC-HS reference rows. Sprint 5 ships a small, clearly
/// labeled DEVELOPMENT_SAMPLE set (prisma/seed-tariff-codes.ts); an
/// official dataset import later writes the same table with sourceType
/// OFFICIAL, so product APIs don't change.
model TariffCode {
  id          String                    @id @default(cuid())
  codeSystem  CodeSystem
  code        String
  /// Digit count: 2 chapter, 4 heading, 6 subheading, 8 ITC-HS tariff line.
  level       Int
  description String
  parentCode  String?
  sourceType  TariffReferenceSourceType @default(DEVELOPMENT_SAMPLE)
  sourceName  String
  isActive    Boolean                   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([codeSystem, code])
  @@index([parentCode])
  @@map("tariff_codes")
}

/// One analysis session: user input + AI/reference interpretation +
/// candidate codes. Temporary/advisory state — distinct from the confirmed
/// OrganizationProduct it may eventually produce.
model ProductAnalysis {
  id String @id @default(cuid())

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  inputType            ProductInputType
  rawInput             String
  /// Hash of normalized input + hints, used to reuse a recent identical analysis instead of re-calling the provider.
  inputKey             String
  categoryHint         String?
  details              Json             @default("{}")
  /// [{ questionId, question, answer }]
  clarificationAnswers Json             @default("[]")

  normalizedProductName    String
  productSummary           String
  suggestedCategoryCode    String
  /// { material, form, intendedUse, composition }
  identification           Json   @default("{}")
  identificationConfidence Int?

  ambiguityStatus     AmbiguityStatus
  ambiguityReason     String?
  /// [{ id, question, options, allowFreeText }]
  clarifyingQuestions Json            @default("[]")

  status   ProductAnalysisStatus @default(PENDING_REVIEW)
  revision Int                   @default(1)

  sourceType    AnalysisSourceType
  provider      String
  model         String?
  promptVersion String
  generatedAt   DateTime           @default(now())

  productInterestId String?
  productInterest   ProductInterest?     @relation(fields: [productInterestId], references: [id], onDelete: SetNull)
  opportunityId     String?
  opportunity       Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  /// The saved product this analysis belongs to (re-analysis) or was confirmed into.
  productId         String?
  product           OrganizationProduct? @relation("ProductAnalyses", fields: [productId], references: [id], onDelete: SetNull)

  candidates        ProductClassificationCandidate[]
  confirmedProducts OrganizationProduct[]            @relation("ProductConfirmedAnalysis")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, inputKey])
  @@map("product_analyses")
}

model ProductClassificationCandidate {
  id String @id @default(cuid())

  analysisId String
  analysis   ProductAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  codeSystem              CodeSystem
  code                    String
  description             String
  /// null for user-entered / manually selected codes — never a fabricated AI confidence.
  confidence              Int?
  rank                    Int
  reasoningSummary        String?
  source                  ClassificationSource
  inReferenceData         Boolean              @default(false)
  referenceDescription    String?
  selectedByUser          Boolean              @default(false)
  confirmedForPlatformUse Boolean              @default(false)

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@map("product_classification_candidates")
}

/// Reusable, organization-scoped product with a user-confirmed (platform
/// use only) classification. Later modules (product/country intelligence,
/// buyers, costing, compliance) reference this, not ProductAnalysis.
model OrganizationProduct {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  displayName    String
  /// Lowercased/trimmed displayName for duplicate detection.
  normalizedName String
  description    String?
  categoryCode   String?

  classificationCode        String
  codeSystem                CodeSystem
  hsCode                    String
  itcHsCode                 String?
  classificationDescription String
  classificationStatus      ProductClassificationStatus
  classificationSource      ClassificationSource
  classificationConfidence  Int?
  lowConfidenceAcknowledged Boolean                     @default(false)

  confirmedByUserId String?
  confirmedBy       User?     @relation("ProductConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedAt       DateTime?

  analysisId String?
  analysis   ProductAnalysis? @relation("ProductConfirmedAnalysis", fields: [analysisId], references: [id], onDelete: SetNull)

  analyses          ProductAnalysis[]   @relation("ProductAnalyses")
  productInterests  ProductInterest[]
  buyerStates       OrganizationBuyer[]
  buyerLeads        BuyerLead[]
  exportCostings    ExportCosting[]
  inquiryItems      InquiryItem[]
  outreachCampaigns OutreachCampaign[]

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, normalizedName])
  @@index([organizationId, classificationCode])
  @@map("organization_products")
}

// --- Sprint 6: product intelligence -------------------------------------

/// Global (not organization-scoped) computed intelligence for one trade
/// dataset version, keyed by the HS/ITC-HS code the dataset covers. Saved
/// organization products reference it by code at request time; tenant
/// access is always checked on the OrganizationProduct first. A Sprint 9
/// ingestion provider produces new datasetVersions; old rows remain as history.
model ProductIntelligenceSnapshot {
  id               String                @id @default(cuid())
  datasetKey       String
  datasetVersion   String
  codeSystem       CodeSystem
  code             String
  sourceType       OpportunitySourceType
  sourceName       String
  opportunityScore Int
  confidence       Int
  /// { demand, exportGrowth, indiaStrength, ... } — 0–100, higher = more favorable.
  components       Json
  /// Full computed ProductIntelligence global section (trend, ecosystem, markets, risk).
  payload          Json
  generatedAt      DateTime              @default(now())

  @@unique([datasetKey, datasetVersion])
  @@index([code])
  @@map("product_intelligence_snapshots")
}

// --- Sprint 7: country intelligence --------------------------------------

/// Global, lightweight score history for one product-code × country pair
/// per dataset version — enough for "previous score / delta / why". Not a
/// time-series or alerting store. No tenant data.
model ProductCountryScoreSnapshot {
  id               String   @id @default(cuid())
  productCode      String
  countryCode      String
  datasetVersion   String
  opportunityScore Int
  confidence       Int
  components       Json
  capturedAt       DateTime @default(now())

  @@unique([productCode, countryCode, datasetVersion])
  @@index([productCode, countryCode, capturedAt])
  @@map("product_country_score_snapshots")
}

// --- Sprint 9: government & trade data platform ------------------------

enum TradeDataSourceType {
  GOVERNMENT
  INTERGOVERNMENTAL
  PUBLIC
  COMMERCIAL
  INTERNAL
  DEMO
}

enum DataAccessMethod {
  API
  CSV
  XLSX
  JSON
  ZIP
  MANUAL_IMPORT
}

enum SourceQualityTier {
  A
  B
  C
  D
  DEMO
}

enum UpdateFrequency {
  DAILY
  MONTHLY
  QUARTERLY
  ANNUAL
  AD_HOC
  STATIC
}

enum IngestionRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum IngestionMode {
  API
  MANUAL_IMPORT
  REFERENCE
}

enum PeriodType {
  YEAR
  QUARTER
  MONTH
}

enum PartnerEntityType {
  COUNTRY
  WORLD
  AGGREGATE
  OTHER
}

enum MappingStatus {
  EXACT
  HIGH_CONFIDENCE
  APPROXIMATE
  UNRESOLVED
}

enum TradeDataIssueSeverity {
  REJECTED
  UNRESOLVED
  WARNING
}

/// Global source registry (no secrets — credentials live in env config only).
/// Static attributes are synced from code (source-registry.ts); `enabled`
/// and run-derived fields are operational state.
model TradeDataSource {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  authority       String
  sourceType      TradeDataSourceType
  accessMethod    DataAccessMethod
  baseUrl         String?
  termsUrl        String?
  description     String
  countryCode     String?
  dataDomains     String[]
  updateFrequency UpdateFrequency
  expectedLagDays Int
  qualityTier     SourceQualityTier
  official        Boolean
  enabled         Boolean             @default(true)
  notes           String?

  lastSuccessfulRunAt   DateTime?
  latestSourcePeriod    String?
  /// End date of the latest period covered, used for freshness.
  latestPeriodEnd       DateTime?
  nextExpectedRefreshAt DateTime?

  runs               TradeDataIngestionRun[]
  rawRecords         TradeDataRawRecord[]
  facts              TradeFact[]
  issues             TradeDataIssueRecord[]
  buyerSourceRecords BuyerSourceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trade_data_sources")
}

model TradeDataIngestionRun {
  id                 String             @id @default(cuid())
  sourceId           String
  source             TradeDataSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status             IngestionRunStatus @default(PENDING)
  mode               IngestionMode
  datasetKeys        String[]
  startedAt          DateTime?
  finishedAt         DateTime?
  recordsFetched     Int                @default(0)
  recordsAccepted    Int                @default(0)
  recordsRejected    Int                @default(0)
  recordsInserted    Int                @default(0)
  recordsUpdated     Int                @default(0)
  duplicatesSkipped  Int                @default(0)
  unresolvedMappings Int                @default(0)
  qualityScore       Int?
  checkpoint         Json?
  sourceVersion      String?
  transformVersion   String
  fileName           String?
  fileChecksum       String?
  /// Opaque storage key (never a filesystem path).
  storageKey         String?
  errorSummary       String?
  initiatedByUserId  String?
  organizationId     String?

  rawRecords TradeDataRawRecord[]
  issues     TradeDataIssueRecord[]
  facts      TradeFact[]

  createdAt DateTime @default(now())

  @@index([sourceId, createdAt])
  @@index([sourceId, fileChecksum])
  @@map("trade_data_ingestion_runs")
}

/// Raw lineage at fetched-unit level (one API response page or one file chunk) — kept for traceability and reprocessing.
model TradeDataRawRecord {
  id              String                @id @default(cuid())
  sourceId        String
  source          TradeDataSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ingestionRunId  String
  run             TradeDataIngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  datasetKey      String
  sourceRecordKey String?
  payload         Json
  sourcePeriod    String?
  sourceUpdatedAt DateTime?
  checksum        String
  importedAt      DateTime              @default(now())

  facts TradeFact[]

  @@index([sourceId, datasetKey, checksum])
  @@map("trade_data_raw_records")
}

/// Canonical, normalized trade fact. Original source values are preserved
/// alongside normalized ones. `factKey` is a deterministic identity per
/// source so re-ingestion upserts instead of duplicating.
model TradeFact {
  id              String                @id @default(cuid())
  factKey         String                @unique
  contentHash     String
  revision        Int                   @default(1)
  sourceId        String
  source          TradeDataSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ingestionRunId  String
  run             TradeDataIngestionRun @relation(fields: [ingestionRunId], references: [id])
  rawRecordId     String?
  rawRecord       TradeDataRawRecord?   @relation(fields: [rawRecordId], references: [id], onDelete: SetNull)
  sourceRecordKey String?
  datasetKey      String

  tradeDirection      TradeDirection
  codeSystem          CodeSystem
  hsCode              String
  hsLevel             Int
  sourceHsCode        String
  reporterCountryCode String
  partnerCountryCode  String?
  partnerEntityType   PartnerEntityType
  sourcePartner       String?
  partnerLabel        String

  periodType  PeriodType
  year        Int
  month       Int?
  periodStart DateTime
  periodEnd   DateTime

  /// Original reported value + currency (never converted silently).
  tradeValue         Decimal?  @db.Decimal(20, 2)
  currency           String
  valueBasis         String?
  normalizedValueUsd Decimal?  @db.Decimal(20, 2)
  fxRate             Decimal?  @db.Decimal(18, 8)
  fxRateDate         DateTime?
  fxSource           String?

  quantity           Decimal?      @db.Decimal(24, 4)
  quantityUnit       String?
  normalizedQuantity Decimal?      @db.Decimal(24, 4)
  normalizedUnit     String?
  unitMappingStatus  MappingStatus
  netWeightKg        Decimal?      @db.Decimal(24, 4)

  portCode              String?
  stateCode             String?
  districtKey           String?
  districtLabel         String?
  districtMappingStatus MappingStatus?

  isEstimated      Boolean?
  sourceUpdatedAt  DateTime?
  transformVersion String
  ingestedAt       DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([hsCode, tradeDirection, reporterCountryCode, year])
  @@index([reporterCountryCode, partnerCountryCode, hsCode, year])
  @@index([sourceId])
  @@map("trade_facts")
}

/// Rejections, unresolved mappings and warnings — traceable per run.
model TradeDataIssueRecord {
  id          String                 @id @default(cuid())
  runId       String
  run         TradeDataIngestionRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId    String
  source      TradeDataSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  kind        String
  severity    TradeDataIssueSeverity
  field       String?
  sourceValue String?
  message     String
  rowRef      String?
  createdAt   DateTime               @default(now())

  @@index([runId])
  @@index([sourceId, kind])
  @@map("trade_data_issues")
}

// --- Sprint 10: buyer discovery -----------------------------------------

enum BuyerType {
  IMPORTER
  DISTRIBUTOR
  WHOLESALER
  RETAILER
  MANUFACTURER
  AGENT
  OTHER
  UNKNOWN
}

enum CompanySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
  UNKNOWN
}

enum ImportFrequency {
  OCCASIONAL
  REGULAR
  FREQUENT
  HIGH_FREQUENCY
  UNKNOWN
}

enum BuyerSourceType {
  PUBLIC_TRADE_DATA
  GOVERNMENT
  PUBLIC_REGISTRY
  BUSINESS_DIRECTORY
  COMMERCIAL_PROVIDER
  USER_PROVIDED
  MANUAL_IMPORT
  DEMO
}

enum BuyerContactType {
  EMAIL
  PHONE
  WHATSAPP
  WEBSITE_FORM
  LINKEDIN_OR_SOCIAL_REFERENCE
  OTHER
}

enum ContactVerificationStatus {
  UNVERIFIED
  SOURCE_LISTED
  FORMAT_VALID
  DOMAIN_MATCHED
  VERIFIED
  INVALID
  STALE
}

enum BuyerVerificationStatus {
  UNVERIFIED
  PARTIALLY_VERIFIED
  VERIFIED_SOURCE
  MULTI_SOURCE_VERIFIED
  NEEDS_REVIEW
  SUSPICIOUS
}

enum BuyerActivityType {
  TRADE_ACTIVITY
  BUSINESS_LISTING
}

/// Canonical company. Global (ownerOrganizationId null) when discovered
/// from a provider; organization-private when manually entered
/// (USER_PROVIDED). Persisted score columns are derived by the enrichment
/// service and only used for filtering/sorting — provider facts live on
/// source records, activity and contacts.
model BuyerCompany {
  id               String      @id @default(cuid())
  canonicalName    String
  normalizedName   String
  countryCode      String
  stateRegion      String?
  city             String?
  address          String?
  website          String?
  websiteDomain    String?
  buyerType        BuyerType   @default(UNKNOWN)
  businessCategory String?
  companySize      CompanySize @default(UNKNOWN)
  employeeRange    String?
  active           Boolean     @default(true)
  isDemo           Boolean     @default(false)

  ownerOrganizationId String?
  ownerOrganization   Organization? @relation(fields: [ownerOrganizationId], references: [id], onDelete: Cascade)
  createdByUserId     String?

  // Derived by BuyerEnrichmentService (cache).
  verificationStatus   BuyerVerificationStatus @default(UNVERIFIED)
  riskScore            Int                     @default(50)
  importFrequency      ImportFrequency         @default(UNKNOWN)
  lastActivityDate     DateTime?
  hasContact           Boolean                 @default(false)
  hasVerifiedContact   Boolean                 @default(false)
  maxContactConfidence Int?
  lastVerifiedAt       DateTime?
  profile              Json?
  enrichedAt           DateTime?
  enrichmentVersion    String?
  enrichmentExpiresAt  DateTime?

  sourceRecords      BuyerSourceRecord[]
  activities         BuyerProductActivity[]
  contacts           BuyerContact[]
  orgStates          OrganizationBuyer[]
  leads              BuyerLead[]
  exportCostings     ExportCosting[]
  inquiries          BuyerInquiry[]
  outreachRecipients CampaignRecipient[]
  duplicatesA        BuyerDuplicateCandidate[] @relation("DuplicateA")
  duplicatesB        BuyerDuplicateCandidate[] @relation("DuplicateB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode, buyerType])
  @@index([normalizedName, countryCode])
  @@index([websiteDomain, countryCode])
  @@index([verificationStatus])
  @@index([riskScore])
  @@index([ownerOrganizationId])
  @@map("buyer_companies")
}

/// Source-specific identity. Never deleted when a provider stops
/// returning a record — marked inactive and kept for lineage.
model BuyerSourceRecord {
  id              String           @id @default(cuid())
  buyerCompanyId  String
  buyerCompany    BuyerCompany     @relation(fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  sourceId        String?
  source          TradeDataSource? @relation(fields: [sourceId], references: [id])
  sourceType      BuyerSourceType
  externalId      String?
  rawName         String
  rawCountry      String?
  rawBuyerType    String?
  sourceUrl       String?
  retrievedAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  sourceUpdatedAt DateTime?
  rawData         Json
  contentHash     String
  confidence      Int
  active          Boolean          @default(true)
  duplicateMatch  String?

  activities BuyerProductActivity[]
  contacts   BuyerContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, externalId])
  @@index([buyerCompanyId])
  @@map("buyer_source_records")
}

model BuyerProductActivity {
  id                String            @id @default(cuid())
  buyerCompanyId    String
  buyerCompany      BuyerCompany      @relation(fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  sourceRecordId    String
  sourceRecord      BuyerSourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  activityType      BuyerActivityType
  hsCode            String?
  productName       String
  importFrequency   ImportFrequency   @default(UNKNOWN)
  /// Source-stated frequency term, kept verbatim.
  rawFrequency      String?
  transactionCount  Int?
  importValueUsd    Decimal?          @db.Decimal(18, 2)
  importQuantity    Decimal?          @db.Decimal(18, 3)
  quantityUnit      String?
  originCountries   String[]
  periodLabel       String?
  firstActivityDate DateTime?
  lastActivityDate  DateTime?
  confidence        Int

  createdAt DateTime @default(now())

  @@index([hsCode])
  @@index([buyerCompanyId])
  @@map("buyer_product_activities")
}

/// Contacts are separate from company identity. Values are stored exactly
/// as the source lists them; nothing is guessed or inferred.
model BuyerContact {
  id                 String                    @id @default(cuid())
  buyerCompanyId     String
  buyerCompany       BuyerCompany              @relation(fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  sourceRecordId     String
  sourceRecord       BuyerSourceRecord         @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  name               String?
  role               String?
  contactType        BuyerContactType
  value              String
  /// Verification mechanism reported by the source (e.g. provider mailbox check). Required for VERIFIED.
  verificationMethod String?
  verificationStatus ContactVerificationStatus @default(UNVERIFIED)
  confidence         Int                       @default(0)
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  isPrimary          Boolean                   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerCompanyId])
  @@map("buyer_contacts")
}

/// POSSIBLE duplicates are recorded for review, never auto-merged.
model BuyerDuplicateCandidate {
  id         String       @id @default(cuid())
  buyerAId   String
  buyerA     BuyerCompany @relation("DuplicateA", fields: [buyerAId], references: [id], onDelete: Cascade)
  buyerBId   String
  buyerB     BuyerCompany @relation("DuplicateB", fields: [buyerBId], references: [id], onDelete: Cascade)
  confidence String
  reason     String
  createdAt  DateTime     @default(now())

  @@unique([buyerAId, buyerBId])
  @@map("buyer_duplicate_candidates")
}

/// Organization-private state for a (global or private) buyer: one row per org+buyer.
model OrganizationBuyer {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buyerCompanyId     String
  buyerCompany       BuyerCompany         @relation(fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  shortlisted        Boolean              @default(false)
  savedAt            DateTime?
  savedByUserId      String?
  productId          String?
  product            OrganizationProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  contextCountryCode String?
  notes              String?
  notesUpdatedAt     DateTime?
  notesUpdatedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, buyerCompanyId])
  @@index([organizationId, shortlisted])
  @@map("organization_buyers")
}

/// Sprint 10 CRM handoff, extended in Sprint 11 into the organization CRM
/// lead. One lead per organization + buyer + product context (contextKey).
model BuyerLead {
  id              String               @id @default(cuid())
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buyerCompanyId  String
  buyerCompany    BuyerCompany         @relation(fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  productId       String?
  product         OrganizationProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// productId or "none" — makes org + buyer + product context idempotent.
  contextKey      String
  countryCode     String
  /// LeadSource value (BUYER_DISCOVERY, MANUAL, OPPORTUNITY, RECOMMENDATION, OTHER).
  source          String               @default("BUYER_DISCOVERY")
  context         Json?
  createdByUserId String
  createdAt       DateTime             @default(now())

  // --- Sprint 11 CRM ---
  stage            CrmStage     @default(NEW)
  priority         LeadPriority @default(MEDIUM)
  ownerUserId      String?
  owner            User?        @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  expectedValue    Decimal?     @db.Decimal(18, 2)
  currency         String?
  nextAction       String?
  nextActionDueAt  DateTime?
  /// Last engagement activity (see ENGAGEMENT_ACTIVITY_TYPES); drives stale detection.
  lastActivityAt   DateTime     @default(now())
  stageChangedAt   DateTime     @default(now())
  wonAt            DateTime?
  wonReason        String?
  lostAt           DateTime?
  lostReason       LostReason?
  lostDetails      String?
  primaryContactId String?
  qualification    Json?
  /// Optimistic-concurrency counter, incremented on every lead mutation.
  version          Int          @default(0)
  updatedAt        DateTime     @default(now()) @updatedAt

  stageHistory LeadStageHistory[]
  activities   LeadActivity[]
  tasks        LeadTask[]
  reminders    LeadReminder[]
  comments     LeadComment[]
  tags         LeadTagAssignment[]
  attachments  LeadAttachment[]
  costings     ExportCosting[]
  inquiries    BuyerInquiry[]

  @@unique([organizationId, buyerCompanyId, contextKey])
  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, nextActionDueAt])
  @@index([organizationId, lastActivityAt])
  @@index([organizationId, updatedAt])
  @@map("buyer_leads")
}

// --- Sprint 11: CRM & lead management -----------------------------------

enum CrmStage {
  NEW
  CONTACTED
  REPLIED
  INTERESTED
  QUALIFIED
  QUOTATION
  NEGOTIATION
  SAMPLE
  PO
  SHIPMENT
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LostReason {
  PRICE
  COMPETITOR
  NO_RESPONSE
  PRODUCT_FIT
  PAYMENT_TERMS
  DELIVERY
  COMPLIANCE
  BUYER_CANCELLED
  OTHER
}

enum LeadActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  STAGE_CHANGE
  TASK
  COMMENT
  ATTACHMENT
  SYSTEM
  OTHER
}

enum ActivityDirection {
  INBOUND
  OUTBOUND
}

enum LeadTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum LeadReminderType {
  FOLLOW_UP
  TASK
  NEXT_ACTION
  CUSTOM
}

enum LeadReminderStatus {
  PENDING
  TRIGGERED
  DISMISSED
  CANCELLED
}

/// Append-only. Rows are never updated or deleted (reopen adds a new row).
model LeadStageHistory {
  id              String    @id @default(cuid())
  organizationId  String
  leadId          String
  lead            BuyerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage       CrmStage?
  toStage         CrmStage
  changedByUserId String?
  changedAt       DateTime  @default(now())
  reason          String?
  /// Won/lost details at the time of the change (lostReason, value…).
  metadata        Json?

  @@index([leadId, changedAt])
  @@index([organizationId, toStage, changedAt])
  @@map("lead_stage_history")
}

/// Business collaboration timeline (not the security audit log).
model LeadActivity {
  id              String             @id @default(cuid())
  organizationId  String
  leadId          String
  lead            BuyerLead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type            LeadActivityType
  title           String
  body            String?
  direction       ActivityDirection?
  occurredAt      DateTime           @default(now())
  contactId       String?
  outcome         String?
  durationMinutes Int?
  location        String?
  metadata        Json?
  actorUserId     String?
  createdAt       DateTime           @default(now())

  @@index([leadId, occurredAt])
  @@map("lead_activities")
}

model LeadTask {
  id               String         @id @default(cuid())
  organizationId   String
  leadId           String
  lead             BuyerLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  assignedToUserId String?
  assignedTo       User?          @relation("LeadTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  dueAt            DateTime?
  priority         LeadPriority   @default(MEDIUM)
  status           LeadTaskStatus @default(OPEN)
  completedAt      DateTime?
  createdByUserId  String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  reminders LeadReminder[]

  @@index([leadId])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, assignedToUserId, status])
  @@map("lead_tasks")
}

/// CRM-local reminder. No scheduler: PENDING rows past remindAt are
/// flipped to TRIGGERED when CRM attention/detail queries read them.
model LeadReminder {
  id              String             @id @default(cuid())
  organizationId  String
  leadId          String
  lead            BuyerLead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  taskId          String?
  task            LeadTask?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  remindAt        DateTime
  type            LeadReminderType   @default(FOLLOW_UP)
  status          LeadReminderStatus @default(PENDING)
  message         String
  triggeredAt     DateTime?
  dismissedAt     DateTime?
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([leadId])
  @@index([organizationId, userId, status, remindAt])
  @@map("lead_reminders")
}

model LeadComment {
  id               String    @id @default(cuid())
  organizationId   String
  leadId           String
  lead             BuyerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorUserId     String?
  body             String
  /// Resolved active org members mentioned with @Name.
  mentionedUserIds String[]
  createdAt        DateTime  @default(now())
  editedAt         DateTime?

  @@index([leadId, createdAt])
  @@index([organizationId])
  @@map("lead_comments")
}

/// Organization-specific tag vocabulary — never shared across tenants.
model LeadTag {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  color          String?
  createdAt      DateTime            @default(now())
  assignments    LeadTagAssignment[]

  @@unique([organizationId, normalizedName])
  @@map("lead_tags")
}

model LeadTagAssignment {
  leadId         String
  lead           BuyerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId          String
  tag            LeadTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime  @default(now())

  @@id([leadId, tagId])
  @@index([tagId])
  @@map("lead_tag_assignments")
}

/// Metadata only; file bytes live in private storage under an opaque key.
model LeadAttachment {
  id               String    @id @default(cuid())
  organizationId   String
  leadId           String
  lead             BuyerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  @@index([leadId])
  @@map("lead_attachments")
}

// --- Sprint 12: buyer outreach & campaigns --------------------------------

enum OutreachChannel {
  EMAIL
  WHATSAPP
  LINKEDIN_MANUAL
  OTHER
}

enum DeliveryMode {
  DEVELOPMENT
  PRODUCTION
}

enum DomainStatus {
  NOT_CONFIGURED
  PENDING
  VERIFIED
  FAILED
  DEVELOPMENT_ONLY
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum OutreachMessageStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENT
  DELIVERED
  OPENED
  REPLIED
  BOUNCED
  FAILED
  CANCELLED
  OPTED_OUT
}

enum RecipientStatus {
  PENDING
  ACTIVE
  EXCLUDED
  REPLIED
  BOUNCED
  OPTED_OUT
  COMPLETED
  CANCELLED
  FAILED
}

enum ExclusionReason {
  NO_CONTACT
  INVALID_CONTACT
  SUPPRESSED_UNSUBSCRIBED
  SUPPRESSED_BOUNCE
  SUPPRESSED_COMPLAINT
  SUPPRESSED_MANUAL
  DUPLICATE
  DEMO_RECIPIENT
  COOLDOWN
  CAMPAIGN_LIMIT
  UNRESOLVED_VARIABLE
}

enum OutreachTemplateType {
  INTRODUCTION
  CATALOG
  QUOTATION_INTRODUCTION
  SAMPLE_OFFER
  FOLLOW_UP
  CUSTOM
}

enum ContentSource {
  TEMPLATE
  AI
  AI_EDITED
  MANUAL
}

enum OutreachEventType {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  REPLIED
  COMPLAINT
  UNSUBSCRIBED
  FAILED
}

enum OutreachEventSource {
  PROVIDER
  MANUAL
  SYSTEM
  DEVELOPMENT
}

enum SuppressionReason {
  UNSUBSCRIBED
  COMPLAINT
  MANUAL_BLOCK
  HARD_BOUNCE
}

/// One row per organization. Provider secrets live in env config, never here.
model OrganizationOutreachSettings {
  id                       String       @id @default(cuid())
  organizationId           String       @unique
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromName                 String?
  fromEmail                String?
  replyTo                  String?
  companyName              String?
  companyWebsite           String?
  signature                String?
  dailyLimit               Int          @default(50)
  maxRecipientsPerCampaign Int          @default(25)
  maxFollowUps             Int          @default(2)
  contactCooldownDays      Int          @default(14)
  timezone                 String       @default("UTC")
  enabled                  Boolean      @default(true)
  domainStatus             DomainStatus @default(NOT_CONFIGURED)
  domainCheckedAt          DateTime?
  domainMessage            String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@map("organization_outreach_settings")
}

/// organizationId null = system starter template (read-only; duplicate to edit).
model OutreachTemplate {
  id              String               @id @default(cuid())
  organizationId  String?
  organization    Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  type            OutreachTemplateType
  subject         String
  body            String
  language        String               @default("en")
  variables       String[]
  active          Boolean              @default(true)
  version         Int                  @default(1)
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([organizationId, active])
  @@map("outreach_templates")
}

model OutreachCampaign {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  productId          String?
  product            OrganizationProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  countryCode        String?
  channel            OutreachChannel      @default(EMAIL)
  status             CampaignStatus       @default(DRAFT)
  templateId         String?
  /// Template version copied at the time content was taken from it.
  templateVersion    Int?
  subject            String               @default("")
  messageBody        String               @default("")
  language           String               @default("en")
  contentSource      ContentSource        @default(MANUAL)
  generationProvider String?
  generatedAt        DateTime?
  sendMode           String               @default("NOW")
  scheduledAt        DateTime?
  timezone           String               @default("UTC")
  /// Snapshot at launch: provider + mode used for every message in this campaign.
  deliveryMode       DeliveryMode?
  provider           String?
  fromName           String?
  fromEmail          String?
  replyTo            String?
  signature          String?
  companyName        String?
  companyWebsite     String?
  audienceCount      Int                  @default(0)
  createdByUserId    String
  launchedByUserId   String?
  launchedAt         DateTime?
  pausedAt           DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  steps      CampaignStep[]
  recipients CampaignRecipient[]
  messages   OutreachMessage[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("outreach_campaigns")
}

/// Step 0 = initial message; 1..3 = follow-ups (delay after the previous send).
/// Content is locked once the campaign leaves DRAFT.
model CampaignStep {
  id         String           @id @default(cuid())
  campaignId String
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  order      Int
  delayDays  Int              @default(0)
  subject    String
  body       String
  active     Boolean          @default(true)

  @@unique([campaignId, order])
  @@map("outreach_campaign_steps")
}

model CampaignRecipient {
  id               String           @id @default(cuid())
  organizationId   String
  campaignId       String
  campaign         OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  buyerCompanyId   String
  buyerCompany     BuyerCompany     @relation(fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  contactId        String?
  crmLeadId        String?
  /// Snapshots taken when the recipient was resolved / at launch.
  address          String?
  contactName      String?
  personalization  Json?
  isDemo           Boolean          @default(false)
  status           RecipientStatus  @default(PENDING)
  excludedReason   ExclusionReason?
  warnings         String[]
  interested       Boolean          @default(false)
  interestedAt     DateTime?
  /// Opaque random token for the public unsubscribe link.
  unsubscribeToken String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  messages OutreachMessage[]

  @@unique([campaignId, buyerCompanyId])
  @@index([campaignId, status])
  @@index([organizationId, buyerCompanyId])
  @@index([crmLeadId])
  @@map("outreach_campaign_recipients")
}

model OutreachMessage {
  id                String                @id @default(cuid())
  organizationId    String
  campaignId        String?
  campaign          OutreachCampaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId       String?
  recipient         CampaignRecipient?    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  buyerCompanyId    String?
  crmLeadId         String?
  channel           OutreachChannel       @default(EMAIL)
  direction         String                @default("OUTBOUND")
  stepOrder         Int                   @default(0)
  /// recipientId:stepOrder (or test:<uuid>) — one message per step per recipient.
  idempotencyKey    String                @unique
  toAddress         String
  fromAddress       String?
  subject           String
  body              String
  provider          String
  providerMessageId String?
  simulated         Boolean               @default(false)
  testSend          Boolean               @default(false)
  status            OutreachMessageStatus @default(SCHEDULED)
  scheduledAt       DateTime?
  attempts          Int                   @default(0)
  lockedAt          DateTime?
  lastError         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  repliedAt         DateTime?
  bouncedAt         DateTime?
  failedAt          DateTime?
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  events OutreachMessageEvent[]

  @@index([status, scheduledAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, toAddress])
  @@index([providerMessageId])
  @@index([buyerCompanyId])
  @@index([crmLeadId])
  @@map("outreach_messages")
}

model OutreachMessageEvent {
  id              String              @id @default(cuid())
  organizationId  String
  messageId       String
  message         OutreachMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type            OutreachEventType
  source          OutreachEventSource
  provider        String?
  providerEventId String?
  occurredAt      DateTime            @default(now())
  metadata        Json?
  createdAt       DateTime            @default(now())

  @@unique([provider, providerEventId])
  @@index([messageId])
  @@map("outreach_message_events")
}

model OutreachSuppression {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Lowercased email address.
  address        String
  buyerCompanyId String?
  reason         SuppressionReason
  source         String
  createdAt      DateTime          @default(now())

  @@unique([organizationId, address])
  @@map("outreach_suppressions")
}

// --- Sprint 14: export costing, pricing & Incoterms ---------------------

enum CostingStatus {
  DRAFT
  READY
  LOCKED
  ARCHIVED
}

enum CostCategory {
  PROCUREMENT
  PACKAGING
  INLAND_TRANSPORT
  INSPECTION
  CHA
  CUSTOMS
  PORT
  FREIGHT
  INSURANCE
  BANKING
  CERTIFICATES
  MISCELLANEOUS
}

enum CostBasis {
  FIXED
  PER_UNIT
  PER_KG
  PER_MT
  PER_CARTON
  PER_CONTAINER
  PERCENTAGE
}

enum PercentageBase {
  PROCUREMENT_VALUE
  PRE_INSURANCE_COST
}

enum CostSourceType {
  USER_ENTERED
  SUPPLIER_QUOTE
  FREIGHT_QUOTE
  SYSTEM_DERIVED
  PUBLIC_DATA
  IMPORTED
  DEMO
}

enum CostConfidence {
  CONFIRMED
  ESTIMATE
  UNKNOWN
}

enum FreightQuoteType {
  MANUAL_ESTIMATE
  FORWARDER_QUOTE
  PROVIDER_RATE
  ACTUAL
}

enum TransportMode {
  SEA
  AIR
  ROAD
  RAIL
  MULTIMODAL
  OTHER
}

enum Incoterm {
  EXW
  FCA
  FOB
  CFR
  CIF
}

enum CostingQuantityUnit {
  KG
  MT
  UNIT
  CARTON
  CONTAINER
}

enum PricingMode {
  MARGIN
  MARKUP
  TARGET_PRICE
}

enum FxSourceType {
  MANUAL
  PUBLIC_API
  COMMERCIAL_PROVIDER
  BANK_RATE
  DEMO
}

enum CostingSnapshotKind {
  READY
  LOCKED
}

/// Organization-scoped FX rate: 1 baseCurrency = rate × quoteCurrency.
/// Immutable once created — "Refresh FX" creates a new snapshot.
model FxRateSnapshot {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseCurrency    String
  quoteCurrency   String
  rate            Decimal      @db.Decimal(24, 10)
  sourceType      FxSourceType @default(MANUAL)
  sourceLabel     String?
  sourceDate      DateTime
  capturedAt      DateTime     @default(now())
  isManual        Boolean      @default(true)
  createdByUserId String?

  scenarioSelections CostingScenarioFx[]

  @@index([organizationId, baseCurrency, quoteCurrency, capturedAt])
  @@map("fx_rate_snapshots")
}

model ExportCosting {
  id                     String               @id @default(cuid())
  organizationId         String
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference              String
  name                   String
  status                 CostingStatus        @default(DRAFT)
  /// Revision number within the root chain (1, 2, …).
  version                Int                  @default(1)
  rootId                 String?
  revisionOfId           String?
  /// Optimistic-concurrency counter; every mutation increments it.
  rowVersion             Int                  @default(0)
  productId              String?
  product                OrganizationProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  buyerCompanyId         String?
  buyerCompany           BuyerCompany?        @relation(fields: [buyerCompanyId], references: [id], onDelete: SetNull)
  crmLeadId              String?
  crmLead                BuyerLead?           @relation(fields: [crmLeadId], references: [id], onDelete: SetNull)
  destinationCountryCode String?
  calculationCurrency    String               @default("INR")
  quoteCurrency          String               @default("USD")
  thinMarginPercent      Decimal              @default(8) @db.Decimal(6, 2)
  notes                  String?
  createdByUserId        String
  updatedByUserId        String?
  readyAt                DateTime?
  lockedAt               DateTime?
  lockedByUserId         String?
  archivedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  scenarios CostingScenario[]
  snapshots CostingSnapshot[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
  @@index([organizationId, productId])
  @@index([organizationId, buyerCompanyId])
  @@index([organizationId, crmLeadId])
  @@map("export_costings")
}

/// Each scenario owns its own cost lines, so editing one never mutates another.
model CostingScenario {
  id               String              @id @default(cuid())
  costingId        String
  costing          ExportCosting       @relation(fields: [costingId], references: [id], onDelete: Cascade)
  name             String
  isBase           Boolean             @default(false)
  sortOrder        Int                 @default(0)
  quantity         Decimal             @db.Decimal(20, 4)
  quantityUnit     CostingQuantityUnit
  netWeightKg      Decimal?            @db.Decimal(20, 4)
  cartonCount      Decimal?            @db.Decimal(20, 4)
  containerCount   Decimal?            @db.Decimal(20, 4)
  incoterm         Incoterm            @default(FOB)
  incotermPlace    String?
  originPort       String?
  destinationPort  String?
  transportMode    TransportMode?
  supplierLabel    String?
  pricingMode      PricingMode         @default(MARGIN)
  pricingValue     Decimal?            @db.Decimal(20, 6)
  buyerTargetPrice Decimal?            @db.Decimal(20, 6)
  notes            String?
  /// Cached deterministic result (formula version inside); recomputed on every change.
  result           Json?
  calculatedAt     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  lines CostingLineItem[]
  fx    CostingScenarioFx[]

  @@index([costingId])
  @@map("costing_scenarios")
}

model CostingScenarioFx {
  id         String          @id @default(cuid())
  scenarioId String
  scenario   CostingScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  /// The non-calculation currency this snapshot converts.
  currency   String
  snapshotId String
  snapshot   FxRateSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([scenarioId, currency])
  @@map("costing_scenario_fx")
}

model CostingLineItem {
  id               String            @id @default(cuid())
  scenarioId       String
  scenario         CostingScenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category         CostCategory
  label            String
  /// null = NOT PROVIDED (distinct from an entered 0).
  amount           Decimal?          @db.Decimal(20, 6)
  currency         String
  basis            CostBasis         @default(FIXED)
  percentageBase   PercentageBase?
  wastagePercent   Decimal?          @db.Decimal(8, 4)
  sourceType       CostSourceType    @default(USER_ENTERED)
  confidence       CostConfidence    @default(ESTIMATE)
  freightQuoteType FreightQuoteType?
  quoteReference   String?
  carrier          String?
  transitDays      Int?
  quoteDate        DateTime?
  validUntil       DateTime?
  routeNotes       String?
  notes            String?
  includeOverride  Boolean?
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([scenarioId])
  @@map("costing_line_items")
}

/// Immutable record of inputs + FX + results at READY/LOCK time.
model CostingSnapshot {
  id              String              @id @default(cuid())
  costingId       String
  costing         ExportCosting       @relation(fields: [costingId], references: [id], onDelete: Cascade)
  kind            CostingSnapshotKind
  formulaVersion  String
  inputs          Json
  results         Json
  createdByUserId String?
  createdAt       DateTime            @default(now())

  @@index([costingId])
  @@map("costing_snapshots")
}

// --- Sprint 13: buyer inquiry / RFQ management --------------------------

enum InquirySource {
  EMAIL_REPLY
  MANUAL
  RFQ_UPLOAD
  CRM
  OTHER
}

enum InquiryStatus {
  NEW
  REVIEWING
  NEEDS_CLARIFICATION
  QUALIFIED
  REJECTED
  ARCHIVED
  CONVERTED
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InquiryExtractionStatus {
  NOT_STARTED
  PROCESSING
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

enum InquiryApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum InquiryRejectCategory {
  NOT_RELEVANT
  PRODUCT_UNAVAILABLE
  COMMERCIAL_MISMATCH
  BUYER_RISK
  INCOMPLETE_REQUIREMENT
  OTHER
}

/// Organization-scoped inbound buyer inquiry. `body` is sanitized plain text
/// (BUYER_PROVIDED); raw HTML, when supplied, is kept in rawBody and never rendered.
model BuyerInquiry {
  id                   String                  @id @default(cuid())
  organizationId       String
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference            String
  source               InquirySource
  /// Dedup key for automatic sources (e.g. outreach:<messageId>); unique per organization.
  sourceKey            String?
  /// OutreachMessage id for EMAIL_REPLY inquiries (reference only, content not duplicated).
  sourceMessageId      String?
  buyerCompanyId       String?
  buyerCompany         BuyerCompany?           @relation(fields: [buyerCompanyId], references: [id], onDelete: SetNull)
  buyerName            String?
  buyerContactId       String?
  contactEmail         String?
  contactName          String?
  crmLeadId            String?
  crmLead              BuyerLead?              @relation(fields: [crmLeadId], references: [id], onDelete: SetNull)
  productId            String?
  countryCode          String?
  subject              String
  body                 String
  rawBody              String?
  bodyWasHtml          Boolean                 @default(false)
  receivedAt           DateTime
  priority             InquiryPriority         @default(MEDIUM)
  suggestedPriority    InquiryPriority?
  priorityReasons      String[]
  status               InquiryStatus           @default(NEW)
  previousStatus       InquiryStatus?
  unread               Boolean                 @default(true)
  assignedToUserId     String?
  extractionStatus     InquiryExtractionStatus @default(NOT_STARTED)
  isRfq                Boolean                 @default(false)
  approvalStatus       InquiryApprovalStatus   @default(NOT_REQUIRED)
  qualification        Json?
  clarification        Json?
  /// Edited-but-unconfirmed RFQ (USER review draft); never treated as confirmed.
  reviewDraft          Json?
  reviewDraftAt        DateTime?
  reviewDraftByUserId  String?
  confirmedRfq         Json?
  confirmedAt          DateTime?
  confirmedByUserId    String?
  confirmedFromVersion Int?
  rejectCategory       InquiryRejectCategory?
  rejectReason         String?
  rejectedAt           DateTime?
  rejectedByUserId     String?
  archivedAt           DateTime?
  rowVersion           Int                     @default(0)
  createdByUserId      String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  attachments      InquiryAttachment[]
  extractions      InquiryExtraction[]
  items            InquiryItem[]
  activities       InquiryActivity[]
  approvals        InquiryApproval[]
  quotationRequest QuotationRequest?
  sampleRequest    SampleRequest?

  @@unique([organizationId, reference])
  @@unique([organizationId, sourceKey])
  @@index([organizationId, status, receivedAt])
  @@index([organizationId, unread])
  @@index([organizationId, assignedToUserId])
  @@index([organizationId, priority])
  @@index([organizationId, source])
  @@index([buyerCompanyId])
  @@index([crmLeadId])
  @@map("buyer_inquiries")
}

model InquiryAttachment {
  id               String       @id @default(cuid())
  organizationId   String
  inquiryId        String
  inquiry          BuyerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  checksum         String
  /// Text for text-based files only (txt/csv); null = text extraction not available.
  extractedText    String?
  uploadedByUserId String?
  createdAt        DateTime     @default(now())
  deletedAt        DateTime?

  @@index([inquiryId])
  @@index([organizationId, checksum])
  @@map("inquiry_attachments")
}

/// Every AI (or dev rule-based) extraction run is kept; re-runs add a new version.
model InquiryExtraction {
  id                 String       @id @default(cuid())
  organizationId     String
  inquiryId          String
  inquiry            BuyerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  version            Int
  status             String
  provider           String
  model              String?
  promptVersion      String
  provenance         String
  overallConfidence  Int?
  data               Json?
  invalidFields      String[]
  error              String?
  attachmentsUsed    String[]
  attachmentsSkipped Json?
  createdByUserId    String?
  createdAt          DateTime     @default(now())

  @@unique([inquiryId, version])
  @@map("inquiry_extractions")
}

/// Human-confirmed RFQ line items (USER_CONFIRMED) — one row per product.
model InquiryItem {
  id              String               @id @default(cuid())
  organizationId  String
  inquiryId       String
  inquiry         BuyerInquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sortOrder       Int                  @default(0)
  productName     String
  productId       String?
  product         OrganizationProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  hsCode          String?
  quantity        Decimal?             @db.Decimal(20, 4)
  quantityUnit    String?
  quantityText    String?
  specification   String?
  packaging       String?
  targetPrice     Decimal?             @db.Decimal(20, 6)
  priceCurrency   String?
  priceUnitBasis  String?
  priceIndicative Boolean              @default(false)
  deliveryDate    String?

  @@index([inquiryId])
  @@index([organizationId, productId])
  @@map("inquiry_items")
}

/// Business timeline of an inquiry (separate from the security AuditLog).
model InquiryActivity {
  id             String       @id @default(cuid())
  organizationId String
  inquiryId      String
  inquiry        BuyerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type           String
  title          String
  metadata       Json?
  actorUserId    String?
  createdAt      DateTime     @default(now())

  @@index([inquiryId, createdAt])
  @@map("inquiry_activities")
}

model InquiryApproval {
  id             String       @id @default(cuid())
  organizationId String
  inquiryId      String
  inquiry        BuyerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  action         String
  reason         String?
  actorUserId    String
  createdAt      DateTime     @default(now())

  @@index([inquiryId])
  @@map("inquiry_approvals")
}

/// Sprint 15 handoff only — no quotation document, number or pricing.
model QuotationRequest {
  id                String       @id @default(cuid())
  organizationId    String
  inquiryId         String       @unique
  inquiry           BuyerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  crmLeadId         String?
  buyerCompanyId    String?
  items             Json
  status            String       @default("PENDING")
  requestedByUserId String
  createdAt         DateTime     @default(now())

  @@index([organizationId])
  @@map("quotation_requests")
}

/// Sprint 22 handoff only — no preparation, courier or tracking workflow.
model SampleRequest {
  id                String       @id @default(cuid())
  organizationId    String
  inquiryId         String       @unique
  inquiry           BuyerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  buyerCompanyId    String?
  productName       String?
  productId         String?
  quantity          String?
  specification     String?
  deadline          String?
  status            String       @default("PENDING")
  requestedByUserId String
  createdAt         DateTime     @default(now())

  @@index([organizationId])
  @@map("sample_requests")
}

// --- Sprint 15: quotation, proforma invoice & buyer purchase order ------

enum QuotationStatus {
  DRAFT
  READY
  ISSUED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
  CANCELLED
}

enum ProformaInvoiceStatus {
  DRAFT
  ISSUED
  SENT
  ACCEPTED
  SUPERSEDED
  CANCELLED
}

enum PurchaseOrderStatus {
  RECEIVED
  UNDER_REVIEW
  MATCHED
  DISCREPANCY
  ACCEPTED
  REJECTED
  CANCELLED
}

/// Minimal per-organization commercial settings (numbering, defaults, bank details).
model CommercialSettings {
  id                       String       @id @default(cuid())
  organizationId           String       @unique
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotationPrefix          String       @default("QT")
  piPrefix                 String       @default("PI")
  yearlyReset              Boolean      @default(true)
  unitPricePrecision       Int          @default(2)
  defaultValidityDays      Int          @default(30)
  quantityTolerancePercent Decimal      @default(0) @db.Decimal(6, 2)
  priceTolerancePercent    Decimal      @default(0) @db.Decimal(6, 2)
  quotationTerms           String?
  piTerms                  String?
  /// Sensitive; never written to audit metadata or logs.
  bankDetails              Json?
  updatedByUserId          String?
  updatedAt                DateTime     @updatedAt

  @@map("commercial_settings")
}

/// Transactional document counters (never derived from row counts; numbers are never reused).
model CommercialNumberSequence {
  id             String @id @default(cuid())
  organizationId String
  docType        String
  year           Int
  lastValue      Int    @default(0)

  @@unique([organizationId, docType, year])
  @@map("commercial_number_sequences")
}

/// One row per revision. rootId groups a lineage sharing quotationNumber.
model Quotation {
  id                 String          @id @default(cuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotationNumber    String
  revision           Int             @default(1)
  rootId             String?
  revisionOfId       String?
  revisionReason     String?
  status             QuotationStatus @default(DRAFT)
  source             String
  buyerCompanyId     String?
  buyerName          String?
  buyerContactId     String?
  crmLeadId          String?
  inquiryId          String?
  quotationRequestId String?
  costingId          String?
  issueDate          DateTime?
  validUntil         DateTime?
  currency           String
  incoterm           String?
  incotermPlace      String?
  originCountry      String?
  destinationCountry String?
  destinationPort    String?
  paymentTerms       String?
  deliveryTerms      String?
  leadTime           String?
  shipmentWindow     String?
  partialShipment    Boolean?
  transshipment      Boolean?
  buyerNotes         String?
  internalNotes      String?
  termsAndConditions String?
  additionalCharges  Decimal         @default(0) @db.Decimal(20, 2)
  chargesLabel       String?
  discount           Decimal         @default(0) @db.Decimal(20, 2)
  subtotal           Decimal?        @db.Decimal(20, 2)
  totalAmount        Decimal?        @db.Decimal(20, 2)
  buyerSnapshot      Json?
  exporterSnapshot   Json?
  issuedAt           DateTime?
  issuedByUserId     String?
  acceptedAt         DateTime?
  acceptedByUserId   String?
  acceptanceSource   String?
  buyerReference     String?
  acceptanceNote     String?
  rejectedAt         DateTime?
  rejectionReason    String?
  cancelledAt        DateTime?
  cancelReason       String?
  expiredAt          DateTime?
  rowVersion         Int             @default(0)
  createdByUserId    String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items            QuotationItem[]
  proformaInvoices ProformaInvoice[]
  purchaseOrders   BuyerPurchaseOrder[]

  @@unique([organizationId, quotationNumber, revision])
  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
  @@index([rootId])
  @@index([buyerCompanyId])
  @@index([crmLeadId])
  @@index([inquiryId])
  @@index([costingId])
  @@map("quotations")
}

model QuotationItem {
  id                 String    @id @default(cuid())
  organizationId     String
  quotationId        String
  quotation          Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sortOrder          Int       @default(0)
  productId          String?
  inquiryItemId      String?
  description        String
  hsCode             String?
  specification      String?
  packaging          String?
  quantity           Decimal   @db.Decimal(20, 4)
  unit               String
  unitPrice          Decimal?  @db.Decimal(20, 6)
  totalPrice         Decimal?  @db.Decimal(20, 2)
  deliveryNotes      String?
  countryOfOrigin    String?
  priceSource        String    @default("MANUAL")
  costingId          String?
  costingScenarioId  String?
  /// Internal pricing snapshot from Sprint 14 (never rendered on buyer documents).
  pricingSnapshot    Json?
  costingUnitPrice   Decimal?  @db.Decimal(20, 6)
  overrideReason     String?
  overriddenByUserId String?

  @@index([quotationId])
  @@index([costingId])
  @@map("quotation_items")
}

model ProformaInvoice {
  id                  String                @id @default(cuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  piNumber            String
  revision            Int                   @default(1)
  rootId              String?
  revisionOfId        String?
  revisionReason      String?
  status              ProformaInvoiceStatus @default(DRAFT)
  source              String                @default("QUOTATION")
  quotationId         String?
  quotation           Quotation?            @relation(fields: [quotationId], references: [id])
  overrideReason      String?
  buyerCompanyId      String?
  buyerName           String?
  crmLeadId           String?
  inquiryId           String?
  issueDate           DateTime?
  validUntil          DateTime?
  currency            String
  incoterm            String?
  incotermPlace       String?
  destinationCountry  String?
  destinationPort     String?
  paymentTerms        String?
  deliveryTerms       String?
  buyerNotes          String?
  internalNotes       String?
  terms               String?
  additionalCharges   Decimal               @default(0) @db.Decimal(20, 2)
  chargesLabel        String?
  discount            Decimal               @default(0) @db.Decimal(20, 2)
  subtotal            Decimal               @default(0) @db.Decimal(20, 2)
  totalAmount         Decimal               @default(0) @db.Decimal(20, 2)
  buyerSnapshot       Json?
  exporterSnapshot    Json?
  /// Sensitive; masked for roles without commercial.settings / proforma_invoice.edit.
  bankDetailsSnapshot Json?
  issuedAt            DateTime?
  issuedByUserId      String?
  cancelledAt         DateTime?
  cancelReason        String?
  rowVersion          Int                   @default(0)
  createdByUserId     String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  items          ProformaInvoiceItem[]
  purchaseOrders BuyerPurchaseOrder[]

  @@unique([organizationId, piNumber, revision])
  @@index([organizationId, status])
  @@index([rootId])
  @@index([quotationId])
  @@index([buyerCompanyId])
  @@index([crmLeadId])
  @@map("proforma_invoices")
}

model ProformaInvoiceItem {
  id              String          @id @default(cuid())
  organizationId  String
  piId            String
  pi              ProformaInvoice @relation(fields: [piId], references: [id], onDelete: Cascade)
  sortOrder       Int             @default(0)
  quotationItemId String?
  productId       String?
  description     String
  hsCode          String?
  specification   String?
  packaging       String?
  quantity        Decimal         @db.Decimal(20, 4)
  unit            String
  unitPrice       Decimal         @db.Decimal(20, 6)
  totalPrice      Decimal         @db.Decimal(20, 2)

  @@index([piId])
  @@map("proforma_invoice_items")
}

/// Buyer-issued PO (buyer-provided evidence). Never generated on the exporter's behalf.
model BuyerPurchaseOrder {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buyerCompanyId    String
  crmLeadId         String?
  inquiryId         String?
  quotationId       String?
  quotation         Quotation?          @relation(fields: [quotationId], references: [id])
  proformaInvoiceId String?
  proformaInvoice   ProformaInvoice?    @relation(fields: [proformaInvoiceId], references: [id])
  poNumber          String
  poNumberKey       String
  poDate            DateTime
  currency          String
  incoterm          String?
  incotermPlace     String?
  paymentTerms      String?
  deliveryTerms     String?
  destination       String?
  totalAmount       Decimal?            @db.Decimal(20, 2)
  notes             String?
  status            PurchaseOrderStatus @default(RECEIVED)
  source            String              @default("MANUAL")
  reviewDecision    String?
  reviewReason      String?
  overrideReason    String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rowVersion        Int                 @default(0)
  createdByUserId   String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  items         BuyerPurchaseOrderItem[]
  discrepancies PODiscrepancy[]
  attachments   PurchaseOrderAttachment[]

  @@unique([organizationId, buyerCompanyId, poNumberKey])
  @@index([organizationId, status])
  @@index([quotationId])
  @@index([proformaInvoiceId])
  @@index([crmLeadId])
  @@map("buyer_purchase_orders")
}

model BuyerPurchaseOrderItem {
  id               String             @id @default(cuid())
  organizationId   String
  purchaseOrderId  String
  purchaseOrder    BuyerPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sortOrder        Int                @default(0)
  quotationItemId  String?
  productId        String?
  buyerProductCode String?
  description      String
  specification    String?
  packaging        String?
  quantity         Decimal            @db.Decimal(20, 4)
  unit             String
  unitPrice        Decimal            @db.Decimal(20, 6)
  totalPrice       Decimal?           @db.Decimal(20, 2)
  deliveryDate     String?

  @@index([purchaseOrderId])
  @@map("buyer_purchase_order_items")
}

model PurchaseOrderAttachment {
  id               String             @id @default(cuid())
  organizationId   String
  purchaseOrderId  String
  purchaseOrder    BuyerPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  checksum         String
  uploadedByUserId String
  createdAt        DateTime           @default(now())

  @@index([purchaseOrderId])
  @@map("purchase_order_attachments")
}

/// Deterministic comparison output. `signature` keeps a human resolution across re-comparisons.
model PODiscrepancy {
  id               String             @id @default(cuid())
  organizationId   String
  purchaseOrderId  String
  purchaseOrder    BuyerPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  signature        String
  against          String
  type             String
  severity         String
  field            String
  itemLabel        String?
  expectedValue    String?
  actualValue      String?
  message          String
  status           String             @default("OPEN")
  resolutionNote   String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())

  @@unique([purchaseOrderId, signature])
  @@map("po_discrepancies")
}

/// Commercial business timeline (separate from the security AuditLog).
model CommercialEvent {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  lineageId      String
  type           String
  title          String
  metadata       Json?
  actorUserId    String?
  createdAt      DateTime @default(now())

  @@index([organizationId, lineageId])
  @@map("commercial_events")
}

// --- Sprint 16: export compliance & trade documents ----------------------

/// Deterministic compliance rule. organizationId null = platform rule (seeded,
/// versioned in code, read-only for users); otherwise an organization's
/// USER_DEFINED rule. A new version is a new row; evaluations keep the
/// version and a snapshot they were evaluated with.
model ComplianceRule {
  id               String        @id @default(cuid())
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  version          Int           @default(1)
  name             String
  description      String
  requirementType  String
  level            String
  severity         String
  basis            String
  jurisdiction     String
  tradeDirection   String        @default("EXPORT")
  countryCode      String?
  productCategory  String?
  hsPrefixes       String[]      @default([])
  conditionJson    Json?
  /// How the requirement is satisfied: registration / certification / document types / manual.
  satisfiedBy      Json
  documentTypes    String[]      @default([])
  responsibleParty String        @default("EXPORTER")
  sourceType       String
  sourceName       String
  sourceUrl        String?
  sourceDate       DateTime?
  lastCheckedAt    DateTime?
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  confidence       String        @default("MEDIUM")
  active           Boolean       @default(true)
  createdByUserId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  instances ComplianceRequirementInstance[]

  @@unique([code, version])
  @@index([organizationId])
  @@map("compliance_rules")
}

/// One compliance checklist per transaction anchor: an accepted buyer PO, or
/// (provisional) a quotation before a PO exists.
model ComplianceChecklist {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrderId   String?      @unique
  quotationId       String?      @unique
  provisional       Boolean      @default(false)
  /// Inputs used for the last evaluation (destination, HS codes, Incoterm …).
  context           Json
  coverage          Json
  readiness         String       @default("NOT_READY")
  evaluatedAt       DateTime     @default(now())
  evaluatedByUserId String?
  readyReadiness    String?
  readyAt           DateTime?
  readyByUserId     String?
  readyNote         String?
  /// Rule ids/versions, statuses and document refs at "Mark compliance ready".
  readySnapshot     Json?
  rowVersion        Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  requirements ComplianceRequirementInstance[]

  @@index([organizationId, readiness])
  @@map("compliance_checklists")
}

model ComplianceRequirementInstance {
  id                 String              @id @default(cuid())
  organizationId     String
  checklistId        String
  checklist          ComplianceChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  ruleId             String?
  rule               ComplianceRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleCode           String
  ruleVersion        Int
  /// Rule as evaluated (later rule changes never rewrite history).
  ruleSnapshot       Json
  productKey         String              @default("")
  productId          String?
  productLabel       String?
  countryCode        String?
  applicability      String
  status             String              @default("NOT_STARTED")
  explanation        String
  evidenceDocumentId String?
  notes              String?
  dueDate            DateTime?
  overrideKind       String?
  overrideReason     String?
  overriddenByUserId String?
  overriddenAt       DateTime?
  manualNote         String?
  manualByUserId     String?
  manualAt           DateTime?
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([checklistId, ruleCode, productKey])
  @@index([organizationId])
  @@index([evidenceDocumentId])
  @@map("compliance_requirement_instances")
}

/// One row per document version; rootId groups a lineage sharing documentNumber.
/// Generated (exporter-prepared) documents keep editable `content` while draft and
/// an immutable `snapshot` once approved. Uploaded documents keep a private file.
model TradeDocument {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rootId            String
  version           Int          @default(1)
  previousVersionId String?
  revisionReason    String?
  documentType      String
  title             String
  documentNumber    String?
  source            String
  responsibleParty  String       @default("EXPORTER")
  status            String
  generated         Boolean      @default(false)
  buyerCompanyId    String?
  purchaseOrderId   String?
  quotationId       String?
  proformaInvoiceId String?
  inquiryId         String?
  productId         String?
  countryCode       String?
  issuer            String?
  issueDate         DateTime?
  expiryDate        DateTime?
  notes             String?
  internalNotes     String?
  storageKey        String?
  originalFilename  String?
  mimeType          String?
  sizeBytes         Int?
  checksum          String?
  content           Json?
  snapshot          Json?
  totals            Json?
  overrideReason    String?
  overrideByUserId  String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectionReason   String?
  archivedAt        DateTime?
  rowVersion        Int          @default(0)
  createdByUserId   String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  extractions   DocumentExtraction[]
  confirmedData DocumentConfirmedData[]

  @@unique([organizationId, documentType, documentNumber, version])
  @@index([organizationId, documentType])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, checksum])
  @@index([rootId])
  @@map("trade_documents")
}

/// Plain-text template fields per generated document type (no HTML).
/// documentType GENERAL carries organization-wide settings (expiry warning window).
model DocumentTemplate {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType      String
  footer            String?
  terms             String?
  declaration       String?
  signatureLabel    String?
  expiryWarningDays Int          @default(30)
  updatedByUserId   String?
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, documentType])
  @@map("document_templates")
}

// --- Sprint 17: document extraction & cross-document validation ----------

/// Immutable extraction attempt for one TradeDocument version. `result` is never
/// edited after completion; human review is stored in DocumentConfirmedData.
model DocumentExtraction {
  id                     String        @id @default(cuid())
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tradeDocumentId        String
  tradeDocument          TradeDocument @relation(fields: [tradeDocumentId], references: [id], onDelete: Cascade)
  documentVersion        Int
  extractionVersion      Int
  /// version + provider + schema + prompt; reused unless force=true.
  cacheKey               String
  providerType           String
  providerName           String
  providerModel          String?
  promptVersion          String?
  schemaVersion          String
  status                 String
  textAvailability       String
  detectedDocumentType   String?
  documentTypeConfidence String?
  result                 Json?
  /// Structured provider response (no model reasoning).
  rawStructuredOutput    Json?
  overallConfidence      Int?
  warnings               Json          @default("[]")
  errorMessage           String?
  startedAt              DateTime      @default(now())
  completedAt            DateTime?
  createdByUserId        String?
  createdAt              DateTime      @default(now())

  confirmations DocumentConfirmedData[]

  @@unique([tradeDocumentId, extractionVersion])
  @@index([organizationId, cacheKey])
  @@map("document_extractions")
}

/// Human-reviewed structured data (corrections stored here, never on the extraction).
model DocumentConfirmedData {
  id                    String              @id @default(cuid())
  organizationId        String
  tradeDocumentId       String
  tradeDocument         TradeDocument       @relation(fields: [tradeDocumentId], references: [id], onDelete: Cascade)
  documentVersion       Int
  extractionId          String?
  extraction            DocumentExtraction? @relation(fields: [extractionId], references: [id], onDelete: SetNull)
  confirmedDocumentType String
  data                  Json
  correctionCount       Int                 @default(0)
  note                  String?
  reviewedByUserId      String
  reviewedAt            DateTime            @default(now())

  @@index([tradeDocumentId])
  @@index([organizationId])
  @@map("document_confirmed_data")
}

/// One deterministic validation run (document-level or whole PO package). Never rewritten.
model DocumentValidationRun {
  id                        String       @id @default(cuid())
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runNumber                 Int
  scope                     String
  purchaseOrderId           String?
  primaryDocumentId         String?
  documentIds               String[]     @default([])
  /// Documents/versions/data sources used and comparison pairs.
  documents                 Json
  ruleVersion               String
  status                    String
  resultSummary             Json
  errorCount                Int          @default(0)
  warningCount              Int          @default(0)
  infoCount                 Int          @default(0)
  createdByUserId           String
  createdAt                 DateTime     @default(now())
  signedOffByUserId         String?
  signedOffAt               DateTime?
  signoffNote               String?
  signoffUnresolvedWarnings Int?
  signoffUnresolvedCritical Int?
  signoffOverrideReason     String?
  rejectedByUserId          String?
  rejectedAt                DateTime?
  rejectionReason           String?

  findings DocumentValidationFinding[]
  comments DocumentValidationComment[]

  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, primaryDocumentId])
  @@map("document_validation_runs")
}

model DocumentValidationFinding {
  id                  String                @id @default(cuid())
  organizationId      String
  runId               String
  run                 DocumentValidationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  signature           String
  type                String
  severity            String
  field               String
  itemReference       String?
  sourceDocumentId    String?
  sourceLabel         String
  referenceDocumentId String?
  referenceLabel      String?
  sourceField         String?
  referenceField      String?
  rule                String
  expectedValue       String?
  actualValue         String?
  normalizedExpected  String?
  normalizedActual    String?
  message             String
  status              String                @default("OPEN")
  resolutionNote      String?
  resolvedByUserId    String?
  resolvedAt          DateTime?
  carriedFromRun      Int?

  comments DocumentValidationComment[]

  @@unique([runId, signature])
  @@index([organizationId])
  @@map("document_validation_findings")
}

model DocumentValidationComment {
  id             String                     @id @default(cuid())
  organizationId String
  runId          String
  run            DocumentValidationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  findingId      String?
  finding        DocumentValidationFinding? @relation(fields: [findingId], references: [id], onDelete: Cascade)
  body           String
  authorUserId   String
  createdAt      DateTime                   @default(now())

  @@index([runId])
  @@map("document_validation_comments")
}

// --- Sprint 18: logistics & shipment management -------------------------
// Freight request ≠ freight quote ≠ shipment ≠ leg ≠ tracking event ≠ exception ≠ claim ≠ buyer update.

model LogisticsSettings {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  etaDelayWarningDays   Int          @default(2)
  etaDelayCriticalDays  Int          @default(7)
  autoDraftBuyerUpdates Boolean      @default(true)
  buyerUpdateMode       String       @default("REQUIRE_APPROVAL")
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  @@map("logistics_settings")
}

/// Freight forwarder / carrier contact (not a supplier-management system).
model LogisticsProvider {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameKey        String
  company        String?
  contactPerson  String?
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  quotes         FreightQuote[]

  @@unique([organizationId, nameKey])
  @@map("logistics_providers")
}

model FreightRequest {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference          String
  purchaseOrderId    String?
  transportMode      String
  shipmentType       String?
  origin             String?
  destination        String?
  portOfLoading      String?
  portOfDischarge    String?
  incoterm           String?
  cargoDescription   String?
  packageCount       Int?
  grossWeightKg      Decimal?       @db.Decimal(14, 3)
  netWeightKg        Decimal?       @db.Decimal(14, 3)
  volumeCbm          Decimal?       @db.Decimal(14, 3)
  readyDate          DateTime?      @db.Timestamptz(3)
  preferredDeparture DateTime?      @db.Timestamptz(3)
  specialHandling    String?
  /// Field → origin (PACKING_LIST, PURCHASE_ORDER, MANUAL …).
  sources            Json
  createdByUserId    String
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  quotes             FreightQuote[]

  @@index([organizationId, purchaseOrderId])
  @@map("freight_requests")
}

model FreightQuote {
